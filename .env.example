# DeepSeek API 配置示例
OPEN_AI_BASE_URL=https://api.deepseek.com
OPEN_AI_API_KEY=your-api-key
OPEN_AI_MODEL=deepseek-flash

# 可选：chat_completions（默认）或 responses
OPEN_AI_API_TYPE=chat_completions

# 可选：模型请求超时（秒）。需与 OCS 的外层请求超时同步配置，
# OCS 超时时间应大于此值并留出网络及服务处理余量。
OPEN_AI_REQUEST_TIMEOUT_SECONDS=60

# 可选：采样温度（0 到 2）；留空则不发送此参数。
# 部分模型或供应商不支持温度参数，遇到请求错误时请删除或留空。
# 控制的是采样随机性，不是准确率旋钮
OPEN_AI_TEMPERATURE=

# 可选：题目文本长度上限及选项数量上限
MAX_TITLE_LENGTH=2000
MAX_OPTIONS_COUNT=26